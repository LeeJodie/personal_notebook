# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.local/

# Locally deployed CosyVoice source, Python runtime and downloaded model assets.
# The tracked wrapper under services/cosyvoice keeps this deployment reproducible.
/services/cosyvoice/CosyVoice/
/services/cosyvoice/.venv/
/services/cosyvoice/models/
/services/cosyvoice/modelscope-cache/
/services/cosyvoice/huggingface-cache/
/services/cosyvoice/__pycache__/

# Locally deployed MeloTTS source, Python runtime and downloaded model assets.
# The tracked wrapper under services/melotts keeps this deployment reproducible.
/services/melotts/MeloTTS/
/services/melotts/.venv/
/services/melotts/huggingface-cache/
/services/melotts/cache/
/services/melotts/__pycache__/

# Python bytecode generated by local parser/crawler verification.
__pycache__/
*.py[cod]
